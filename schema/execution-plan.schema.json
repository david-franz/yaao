{
  "$ref": "#/definitions/ExecutionPlan",
  "definitions": {
    "ExecutionPlan": {
      "type": "object",
      "properties": {
        "plan": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-_]*$"
            },
            "version": {
              "type": "number",
              "const": 1
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "config": {
          "type": "object",
          "properties": {
            "base-branch": {
              "type": "string"
            },
            "max-parallel": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "worktree-root": {
              "type": "string"
            },
            "merge": {
              "type": "object",
              "properties": {
                "strategy": {
                  "type": "string",
                  "enum": [
                    "auto",
                    "pr",
                    "manual"
                  ]
                },
                "on-conflict": {
                  "type": "string",
                  "enum": [
                    "manual",
                    "agent"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "context": {
          "type": "object",
          "properties": {
            "ctx-sys": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "require-query": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-_]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "prompt-ref": {
                "type": "string"
              },
              "depends": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "agent": {
                "type": "string",
                "enum": [
                  "claude-code",
                  "cursor",
                  "copilot",
                  "codex",
                  "api"
                ]
              },
              "model": {
                "type": "string"
              },
              "api": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "enum": [
                      "anthropic",
                      "openai",
                      "openrouter"
                    ]
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "base-url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "provider",
                  "model"
                ],
                "additionalProperties": false
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "branch": {
                "type": "string"
              },
              "worktree": {
                "type": "string"
              },
              "timeout": {
                "type": "string",
                "pattern": "^[0-9]+(ms|s|m|h)$"
              },
              "retries": {
                "type": "integer",
                "minimum": 0,
                "default": 0
              },
              "validation": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "must-pass": {
                    "type": "boolean",
                    "default": true
                  }
                },
                "additionalProperties": false
              },
              "merge": {
                "type": "string",
                "enum": [
                  "auto",
                  "pr",
                  "manual",
                  "none"
                ]
              },
              "context": {
                "type": "object",
                "properties": {
                  "ctx-sys": {
                    "type": "object",
                    "properties": {
                      "enabled": {
                        "type": "boolean"
                      },
                      "require-query": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {}
              }
            },
            "required": [
              "id",
              "title",
              "agent"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "plan"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
