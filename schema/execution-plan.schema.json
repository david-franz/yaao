{
  "$ref": "#/definitions/ExecutionPlan",
  "definitions": {
    "ExecutionPlan": {
      "type": "object",
      "properties": {
        "plan": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-_]*$"
            },
            "version": {
              "type": "number",
              "const": 1
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "config": {
          "type": "object",
          "properties": {
            "base-branch": {
              "type": "string"
            },
            "max-parallel": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "worktree-root": {
              "type": "string"
            },
            "merge": {
              "type": "object",
              "properties": {
                "strategy": {
                  "type": "string",
                  "enum": [
                    "auto",
                    "pr",
                    "manual"
                  ]
                },
                "on-conflict": {
                  "type": "string",
                  "enum": [
                    "manual",
                    "agent"
                  ]
                },
                "history": {
                  "type": "string",
                  "enum": [
                    "merge",
                    "rebase"
                  ]
                }
              },
              "additionalProperties": false
            },
            "context": {
              "type": "object",
              "properties": {
                "per-dep-budget": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "total-budget": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            },
            "hooks": {
              "type": "object",
              "properties": {
                "post-task": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "command": {
                        "type": "string",
                        "minLength": 1
                      },
                      "cwd": {
                        "type": "string"
                      },
                      "must-pass": {
                        "type": "boolean",
                        "default": true
                      }
                    },
                    "required": [
                      "command"
                    ],
                    "additionalProperties": false
                  },
                  "default": []
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "context": {
          "type": "object",
          "properties": {
            "ctx-sys": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "require-query": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-_]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "prompt-ref": {
                "type": "string"
              },
              "depends": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "agent": {
                "type": "string",
                "enum": [
                  "claude-code",
                  "cursor",
                  "copilot",
                  "codex",
                  "api"
                ]
              },
              "model": {
                "type": "string"
              },
              "api": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "enum": [
                      "anthropic",
                      "openai",
                      "openrouter"
                    ]
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "base-url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "provider",
                  "model"
                ],
                "additionalProperties": false
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "branch": {
                "type": "string"
              },
              "worktree": {
                "type": "string"
              },
              "timeout": {
                "type": "string",
                "pattern": "^[0-9]+(ms|s|m|h)$"
              },
              "retries": {
                "type": "integer",
                "minimum": 0,
                "default": 1
              },
              "validation": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "must-pass": {
                    "type": "boolean",
                    "default": true
                  },
                  "cwd": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "merge": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "auto",
                      "pr",
                      "manual",
                      "none"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "strategy": {
                        "$ref": "#/definitions/ExecutionPlan/properties/tasks/items/properties/merge/anyOf/0"
                      },
                      "into": {
                        "type": "string"
                      },
                      "when": {
                        "type": "string",
                        "enum": [
                          "completed",
                          "manual"
                        ],
                        "default": "completed"
                      },
                      "create-if-missing": {
                        "type": "boolean",
                        "default": true
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              },
              "context": {
                "type": "object",
                "properties": {
                  "ctx-sys": {
                    "type": "object",
                    "properties": {
                      "enabled": {
                        "type": "boolean"
                      },
                      "require-query": {
                        "type": "boolean"
                      },
                      "directive": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {}
              },
              "setup": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "permissions": {
                "type": "string",
                "enum": [
                  "ask",
                  "allow-edits",
                  "allow-all"
                ]
              },
              "inherit-dep-context": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "title",
              "agent"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "plan"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
