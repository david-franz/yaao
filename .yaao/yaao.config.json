{
  "$schema": "https://yaao.dev/schema/config.json",
  "version": 1,
  "defaults": {
    "agent": "claude-code",
    "model": "opus",
    "max-parallel": 4,
    "base-branch": "main",
    "worktree-root": ".yaao/worktrees"
  },
  "merge": {
    "strategy": "auto",
    "on-conflict": "manual"
  },
  "agents": {
    "claude-code": {
      "enabled": true
    },
    "cursor": {
      "enabled": true
    },
    "copilot": {
      "enabled": true
    },
    "codex": {
      "enabled": true
    },
    "api": {
      "providers": {}
    }
  },
  "ctx-sys": {
    "enabled": false,
    "auto-spawn": true,
    "require-query": false
  },
  "plan": {
    "format": "markdown",
    "speckit": false
  }
}
